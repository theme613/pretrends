# Both keys are server-only. Missing keys leave unverified posts hidden.
APIFY_API_TOKEN=
GRAFILAB_API_KEY=
GRAFILAB_MODEL=qwen/qwen3.7-flash
# Required on Vercel so saved ideas survive deployments and server restarts.
# Optional when running locally with a persistent data directory.
BLOB_READ_WRITE_TOKEN=
# Must match the access setting of the connected Blob store.
BLOB_ACCESS=public
