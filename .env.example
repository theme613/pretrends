# ==============================================================================
# TrendRadar Environment Configuration
# ==============================================================================

# Apify API Token (required for live web scraping from TikTok & Instagram)
# Get your free token at: https://console.apify.com/account/integrations
# If left empty, TrendRadar will run in demo mode with sample trends.
APIFY_API_TOKEN=

# Grafilab / OpenAI API Key (optional, for AI trend analysis and velocity scoring)
# https://llm.grafilab.ai/
GRAFILAB_API_KEY=
GRAFILAB_MODEL=qwen/qwen3.7-flash
